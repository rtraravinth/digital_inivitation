# The FACET API. Start it with:
#   cd backend && .venv/Scripts/python -m uvicorn app.main:app --reload
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase Authentication — the web app's config from Firebase → Project
# settings → Your apps. Public by design (it ships to every browser) but read
# at build time. The API needs the same project id as FACET_FIREBASE_PROJECT_ID.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# The domain pages publish under: <subdomain>.<root>/<slug>. Every
# *.localhost name reaches this machine, so in development
#   NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# serves rohan.localhost:3000/founder (set FACET_ROOT_DOMAIN the same in
# backend/.env). Empty keeps pages at /p/<subdomain>/<slug>, which is what
# opening the app from a phone on the LAN needs. Build-time.
NEXT_PUBLIC_ROOT_DOMAIN=
