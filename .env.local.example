# The FACET API. Start it with:
#   cd backend && .venv/Scripts/python -m uvicorn app.main:app --reload
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase Authentication — the web app's config from Firebase → Project
# settings → Your apps. Public by design (it ships to every browser) but read
# at build time. The API needs the same project id as FACET_FIREBASE_PROJECT_ID.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
