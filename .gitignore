# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real ones stay out, templates are part of the repo
.env*
!.env.example
!.env.local.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# browser artifacts from Playwright MCP checks
/.playwright-mcp/

# design-tool working directory: local config, review screenshots, surface notes
/.impeccable/

# graphify knowledge graph output
graphify-out/
.claude/

# CodeQL databases, scan results, and VS Code extension scaffolding
codeql-dbs/
codeql-results/
codeql-custom-queries-*/
.vscode/

# Coverage output from pytest --cov
.coverage
coverage.xml

# Firebase service-account keys (the downloaded file is named like this).
# A secret: keep it out of the repository.
*firebase-adminsdk*.json
