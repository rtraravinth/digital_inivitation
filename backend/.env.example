# Copy to .env and edit. Every key is prefixed FACET_.

# ── database ──────────────────────────────────────────────────────────────
# asyncpg driver, not psycopg. The test database is created and dropped by
# the test suite, so it must be a name you are happy to lose.
FACET_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/facet
FACET_TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/facet_test

# ── auth ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this invalidates every access token.
FACET_JWT_SECRET=change-me-to-a-long-random-string-before-any-real-use
FACET_ACCESS_TOKEN_TTL_MINUTES=60
FACET_REFRESH_TOKEN_TTL_DAYS=30

# ── http ──────────────────────────────────────────────────────────────────
# Explicit origins, because credentials are allowed. A wildcard is rejected
# by browsers when allow_credentials is on, and would be wrong anyway.
FACET_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FACET_PUBLIC_BASE_URL=http://localhost:8000

# ── storage ───────────────────────────────────────────────────────────────
# Where uploaded bytes land. Relative paths resolve against the backend dir.
FACET_MEDIA_ROOT=media
# How long a signed upload URL keeps opening. An <img> cannot send a bearer
# token, so an owner's asset URL carries a signature instead.
FACET_ASSET_URL_TTL_MINUTES=1440

# dev | test | prod. Only "prod" sets Secure on the refresh cookie and
# turns off the interactive docs.
FACET_ENV=dev

# ── firebase ──────────────────────────────────────────────────────────────
# Firebase Authentication proves who someone is; the project id is all that
# is needed to verify its ID tokens — no service-account key. Empty refuses
# every sign-in.
FACET_FIREBASE_PROJECT_ID=
# The service-account key (Firebase → Project settings → Service accounts →
# Generate new private key): the JSON on one line, or a path to the file.
# Lets FACET end its sessions when Firebase disables, deletes or revokes a
# user (a password reset does that). It is a secret: never commit it.
FACET_FIREBASE_SERVICE_ACCOUNT=
