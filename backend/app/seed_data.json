        "blocks": [
          {
            "id": "s4b1",
            "type": "services",
            "title": "What I offer",
            "items": [
              {
                "id": "s4v1",
                "title": "Financial plan",
                "text": "A written plan for your household: goals, insurance, investments and tax, reviewed with you in two sessions.",
                "price": "₹45,000 one-time"
              },
              {
                "id": "s4v2",
                "title": "Ongoing advice",
                "text": "Quarterly reviews, rebalancing calls and a WhatsApp line for the questions in between.",
                "price": "₹90,000 a year"
              },
              {
                "id": "s4v3",
                "title": "Second opinion",
                "text": "One session on a portfolio or a policy you already hold, with a written note after.",
                "price": "₹8,000"
              }
            ]
          },
          {
            "id": "s4b2",
            "type": "tabs",
            "title": "How it works",
            "items": [
              {
                "id": "s4a1",
                "label": "First call",
                "text": "Thirty minutes, free. We talk about where you are and whether I am the right adviser. Often I am not, and I will say so."
              },
              {
                "id": "s4a2",
                "label": "The plan",
                "text": "Two working sessions and a written plan within three weeks. Every recommendation says what it costs you and why."
              },
              {
                "id": "s4a3",
                "label": "After",
                "text": "You implement on your own platforms; I never hold your money. Reviews every quarter, more often in a bad year."
              }
            ]
          },
          {
            "id": "s4b3",
            "type": "faq",
            "title": "Questions families ask",
            "items": [
              {
                "id": "s4f1",
                "question": "Do you earn commissions?",
                "answer": "No. I am fee-only: the fee is the whole of what I earn, so no product I suggest pays me anything."
              },
              {
                "id": "s4f2",
                "question": "Do you work outside Bengaluru?",
                "answer": "Yes. Most sessions are on video; about a third of the families I advise live in other cities."
              },
              {
                "id": "s4f3",
                "question": "Is there a minimum portfolio size?",
                "answer": "No minimum. The plan is about the household, not the size of the portfolio."
              }
            ]
          }
        ],
        "hidden": false,
